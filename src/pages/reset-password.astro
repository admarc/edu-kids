---
/**
 * Reset Password Page
 *
 * Public page for setting new password using token from email
 * Token is passed as query parameter: ?token=...&type=recovery
 */

import Layout from "../layouts/Layout.astro";
import { AuthFormContainer } from "../components/auth/AuthFormContainer";
import { ResetPasswordForm } from "../components/auth/ResetPasswordForm";

const { searchParams } = Astro.url;
const token = searchParams.get("token");
---

<Layout title="Resetowanie hasła - EduKids">
  <AuthFormContainer client:load title="Nowe hasło" description="Wprowadź nowe hasło dla swojego konta">
    <ResetPasswordForm client:load token={token} />
  </AuthFormContainer>
</Layout>
